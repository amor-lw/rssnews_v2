# Copy this file to .env and fill in real values.

NEWSAPI_KEY=
BASE_URL=http://your-server-ip/rss
OUTDIR=dist
PUBLISH_DIR=/opt/rssnews/public
PUBLISH_SUBPATH=rss
RSS_BIND=0.0.0.0
RSS_PORT=80
STATE_DIR=state
DATABASE_PATH=state/rssnews.db
ADMIN_TOKEN=
FETCH_HOURS=24
HN_LIMIT=60
MAX_ITEMS=120
NEWS_MAX_ITEMS=0
RADAR_MAX_ITEMS=50
DAILY_MAX_ITEMS=25
NEWSAPI_PAGE_SIZE=100
GDELT_HOT_ENABLED=false
GDELT_MAX=0
CISA_KEV_ENABLED=true
CISA_KEV_LIMIT=50
HN_HOT_MAX_ITEMS=50
HN_HOT_ENABLED=true
